# =============================================================
# Solita Courier Management System - environment variables
# Copy to `.env` in the project root for local development.
# On Vercel, add the same variables in Project Settings → Environment Variables.
# Never commit real values.
# =============================================================

# development | test | production  (Vercel sets production automatically)
NODE_ENV=development

# MongoDB Atlas connection string. The database name is always `solita`.
# Example format: mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=

# Optional, local only. If `npm run db:init` fails with "querySrv ECONNREFUSED"
# (your network/router refuses the DNS SRV lookup that mongodb+srv:// needs),
# point Node at public DNS servers. Leave empty on Vercel.
MONGODB_DNS_SERVERS=

# Long random secret (at least 32 characters) used to sign CSRF tokens.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Allowed browser origin(s) of the frontend, comma separated.
# Local: http://localhost:5173   Production: https://your-project.vercel.app
CLIENT_ORIGIN=http://localhost:5173

# ---------------- EasyOrders ----------------
# API key created in the EasyOrders seller dashboard → Public API.
# Needs the permissions: orders:read and orders:update
EASYORDERS_API_KEY=
EASYORDERS_API_BASE_URL=https://api.easy-orders.net

# The `secret` value EasyOrders shows after you create a webhook.
# If you create two separate webhooks (orders + status) with different secrets,
# put the status webhook secret in EASYORDERS_STATUS_WEBHOOK_SECRET.
EASYORDERS_WEBHOOK_SECRET=
EASYORDERS_STATUS_WEBHOOK_SECRET=

# ---------------- Background processing ----------------
# Secret that protects /api/cron/process (Vercel Cron sends it automatically
# as "Authorization: Bearer <CRON_SECRET>" when this variable is set).
CRON_SECRET=

# ---------------- Local development only ----------------
# Port of the local Express server.
PORT=4000

# true = run the API with a temporary in-memory MongoDB and clearly marked demo data.
# Refused automatically when NODE_ENV=production or on Vercel.
MOCK_MODE=false
